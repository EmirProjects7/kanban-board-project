{
  "name": "kanban-board-project",
  "private": true,
  "scripts": {
    "db": "docker compose -f backend/docker-compose.yml up -d --wait",
    "dev": "npm run db && concurrently -n backend,frontend -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "demo": "tsx scripts/record-demo.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.12"
  }
}
