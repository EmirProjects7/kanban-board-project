# Copy to backend/.env and fill in your own values. Never commit that file.

# Credentials Docker creates the database with. They have to match the ones
# inside DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host port for the postgres container, and the interface it is published on.
# Change the port when another project already holds 5432, and change the
# port inside DATABASE_URL to match.
POSTGRES_PORT=5432
POSTGRES_BIND_HOST=127.0.0.1

DATABASE_URL=

# Generate one rather than inventing it: openssl rand -base64 32
# The server refuses to start on anything shorter than 32 characters, since a
# guessable secret here means anyone can mint a token for any account.
JWT_SECRET=

# Where the API listens. 127.0.0.1 keeps it off the local network; only a
# real deployment needs 0.0.0.0.
BACKEND_HOST=127.0.0.1
# Deliberately not PORT: one `npm run dev` starts both apps, so a generic
# PORT would be picked up by the frontend dev server too.
BACKEND_PORT=3000

# The origin CORS allows through.
FRONTEND_URL=http://localhost:5173
