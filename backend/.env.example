DATABASE_URL=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
JWT_SECRET=

# Optional, defaults shown
# BACKEND_PORT=3000
# Localhost only. A host that must reach the API from outside the machine
# sets this to 0.0.0.0; leave it alone for local work.
# BACKEND_HOST=127.0.0.1
# FRONTEND_URL=http://localhost:5173
# Host port for the postgres container. Change it (and the port in
# DATABASE_URL) if another project already uses 5432.
# POSTGRES_PORT=5432
